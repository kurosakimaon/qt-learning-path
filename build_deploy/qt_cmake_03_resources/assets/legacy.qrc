<!DOCTYPE RCC>
<!-- ==========================================================================
     传统 .qrc 清单：route A（AUTORCC）用它。
     ==========================================================================
     路径规则：资源路径 = ":" + <qresource prefix> + 条目路径（或 alias）
       · <file> 的内容是**相对本 .qrc 文件所在目录**的路径
       · 不写 alias 时，条目路径就是文件名本身（可带子目录）
       · 写了 alias，就用 alias 替换条目路径，但字节还是那一份
     ==========================================================================
     本清单只放 style.qss：prefix="/legacy"，所以运行时可读 ":/legacy/style.qss"。
     路线 B（qt_add_resources）已经把同一份文件放到了 ":/style.qss"。
   ========================================================================== -->
<RCC>
    <qresource prefix="/legacy">
        <file>style.qss</file>
    </qresource>
</RCC>
